// Rota — build configuration / secrets template.
//
// Copy this file to `Secrets.xcconfig` (which is gitignored) and fill in your
// Supabase project values. The app reads these via Info.plist substitution /
// AppConfig at runtime. Leaving them blank keeps the app in MOCK mode with
// rich sample data so it runs in the Simulator with zero setup.

// Your Supabase project URL, WITHOUT the scheme, e.g. abcdxyz.supabase.co
SUPABASE_URL_HOST =

// Your Supabase anon/public key (safe for client use; protected by RLS).
SUPABASE_ANON_KEY =

// Backend mode: MOCK or SUPABASE
BACKEND_MODE = MOCK

// Your Apple development team id (optional, for device signing).
DEVELOPMENT_TEAM =
